{
  "title": "PrintFlow",
  "uid": "printflow",
  "tags": ["printflow", "kubernetes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "ns",
        "label": "Ambiente",
        "type": "custom",
        "query": "printflow-dev,printflow-prod",
        "current": { "text": "printflow-dev", "value": "printflow-dev" },
        "options": [
          { "text": "printflow-dev", "value": "printflow-dev", "selected": true },
          { "text": "printflow-prod", "value": "printflow-prod", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Peticiones por segundo (API)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(rate(http_requests_total{namespace=\"$ns\"}[1m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Latencia p95 de la API",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"$ns\"}[5m])) by (le))", "legendFormat": "p95" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Réplicas de la API (HPA)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kube_deployment_status_replicas{deployment=\"api\", namespace=\"$ns\"}", "legendFormat": "réplicas" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{horizontalpodautoscaler=\"api\", namespace=\"$ns\"}", "legendFormat": "máximo HPA" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "CPU por pod de la API (núcleos)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$ns\", pod=~\"api-.*\", container=\"api\"}[2m]))", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Respuestas 4xx / 5xx (los 409 son reglas de negocio)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (status) (rate(http_requests_total{namespace=\"$ns\", status=~\"4..|5..\"}[5m]))", "legendFormat": "HTTP {{status}}" }]
    },
    {
      "id": 6, "type": "stat", "title": "Eventos pendientes del outbox",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 50 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "max(printflow_outbox_pendientes{namespace=\"$ns\"})", "legendFormat": "pendientes" }]
    },
    {
      "id": 7, "type": "bargauge", "title": "Pedidos por estado",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "basic" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "max by (estado) (printflow_pedidos{namespace=\"$ns\"})", "legendFormat": "{{estado}}" }]
    }
  ]
}
